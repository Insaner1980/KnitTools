    <string name="welcome_screen_title">Pick Up Where You Left Off</string>
    <!-- Aloitustilan kuvaus laskurin, ohjeen lukukohdan ja projektitietojen säilymisestä. -->
    <string name="welcome_body">KnitTools keeps your count, your place in the pattern and your project details together. Put your work down any time and come back to exactly the right spot.</string>
    <!-- Aloituksen luottamusteksti; ei käyttäjätiliä eikä pilvitallennuslupausta. -->
    <string name="welcome_trust">No account needed. Your projects stay on this phone.</string>
    <!-- Toiminto siirtyy suoraan työkaluihin ilman projektin luontia. -->
    <string name="welcome_tools_only">I just need the tools</string>
    <!-- Aloitusesittelyn sulkemisen saavutettavuuskuvaus. -->
    <string name="welcome_dismiss_a11y">Hide introduction</string>
    <!-- Tiiviin aloituksen neuleotsikko. Puikkoidiomi voidaan korvata luontevalla työn alla -ilmauksella. -->
    <string name="start_compact_title_knitting">What\'s On Your Needles?</string>
    <!-- Tiiviin aloituksen virkkausotsikko. Koukkuidiomi voidaan korvata luontevalla työn alla -ilmauksella. -->
    <string name="start_compact_title_crochet">What\'s On Your Hook?</string>
    <!-- Tiiviin aloituksen teksti nykyisen tai uuden projektin lisäämisestä. -->
    <string name="start_compact_body">Add the project you\'re working on, or start a new one.</string>
    <!-- Neuleprojektin nimen esimerkki; säilytä luonnollinen kirjainkoko. -->
