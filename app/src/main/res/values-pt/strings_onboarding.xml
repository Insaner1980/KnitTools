    <!-- Tavoitteen virhe; %1$s on valmiiksi paikallistettu enimmäisluku. -->
    <string name="project_target_error">Introduza um número de 1 a %1$s.</string>
    <!-- Esikatselun saavutettava kuvaus; %1$s on valmis laskuriteksti. -->
    <string name="project_create_preview_a11y">Pré-visualização: %1$s</string>
    <!-- Vihjeen kuittauspainike. -->
    <string name="tip_got_it">Entendido</string>
    <!-- Kerroslaskurin ensimmäinen vihje; iso numero on myös painike. -->
    <string name="tip_first_row_rows">Quando terminar uma carreira, toque em +. Também pode tocar no número grande.</string>
    <!-- Kierroslaskurin ensimmäinen vihje; iso numero on myös painike. -->
    <string name="tip_first_row_rounds">Quando terminar uma volta, toque em +. Também pode tocar no número grande.</string>
    <!-- Toistolaskurin ensimmäinen vihje; iso numero on myös painike. -->
    <string name="tip_first_row_repeats">Quando terminar uma repetição, toque em +. Também pode tocar no número grande.</string>
    <!-- Mukautetun yksikön ensimmäinen laskurivihje. -->
    <string name="tip_first_row_custom">Toque em + sempre que terminar uma unidade. Também pode tocar no número grande.</string>
    <!-- Kumoamisvihje käyttää samaa toimintonimeä kuin laskurin Undo. -->
    <string name="tip_undo">Guardado. Tocou por engano? Anular reverte a última alteração.</string>
    <!-- Askelkoko määrittää yhden painalluksen lisäyksen. -->
    <string name="tip_step_size">Conta mais de uma unidade de cada vez? Altere aqui quanto cada toque acrescenta.</string>
    <!-- Työskentelyjakso käynnistetään käsin; aikaa ei seurata automaattisesti. -->
    <string name="tip_work_session">Quer saber quanto tempo demora este projeto? Inicie uma sessão de trabalho neste menu. A contagem do tempo nunca começa sozinha.</string>
    <!-- Projektisivun esittely; Continue viittaa jatkamistoimintoon. -->
    <string name="tip_overview_intro">Aqui está o projeto completo: receita, fio, notas e fotos. Continuar leva-o de volta ao contador.</string>
    <!-- Vihje ohjeen liittämiseen projektiin. -->
    <string name="tip_pattern_tile">Anexe a receita para a manter junto deste projeto.</string>
    <!-- Follow main counter viittaa PDF-lukijan nykyiseen paikallistettuun asetukseen. -->
    <string name="tip_reading_line">Ative Seguir o contador principal e a linha de leitura acompanha a contagem.</string>
    <!-- Vihje näytön pitämiseen päällä laskemisen aikana. -->
    <string name="tip_keep_screen_on">O ecrã apaga-se enquanto trabalha? Mantenha-o ativo enquanto conta.</string>
    <!-- Toiminto käyttää samaa nimeä kuin nykyinen näytön hereilläpitoasetus. -->
    <string name="tip_keep_screen_on_action">Manter o ecrã ativo</string>
    <!-- Tavoitteen saavuttamisen palaute; jatkaminen ja projektin valmistuminen ovat eri toimintoja. -->
    <string name="tip_target_reached">Objetivo atingido. Continue a contar ou marque o projeto como concluído no menu da página do projeto.</string>
    <!-- Ensimmäisen tallennetun työskentelyjakson palaute. -->
    <string name="tip_first_session_saved">A sua primeira sessão de trabalho está guardada. O tempo total deste projeto aparece aqui.</string>
    <!-- Varmuuskopion tarve puhelimen vaihtamisen varalta. -->
    <string name="tip_backup">Os seus projetos estão apenas neste telemóvel. Faça uma cópia de segurança para os proteger se mudar de telemóvel.</string>
    <!-- Varmuuskopioinnin käynnistävä toiminto. -->
    <string name="tip_backup_action">Criar cópia de segurança</string>
    <!-- Projektikansiot avataan näkymän otsikosta. -->
    <string name="tip_folders">Muitos projetos? Organize-os em pastas a partir do título.</string>
    <!-- Laskuripienoisohjelman hyöty Androidin aloitusnäytössä. -->
    <string name="tip_widget">Conte a partir do ecrã inicial sem abrir a aplicação.</string>
    <!-- Avaa nykyisen widgetin lisäyksen. -->
    <string name="tip_widget_action">Adicionar widget</string>
    <!-- Työkalut toimivat ilman verkkoyhteyttä; esimerkkiluvut eivät ole käyttäjän tietoja. -->
    <string name="tip_tools_intro">As calculadoras funcionam offline. Os valores de exemplo mostram o que introduzir.</string>
    <!-- Asetusten toiminto palauttaa vihjeet näkyviin. -->
    <string name="settings_show_tips_again">Voltar a mostrar dicas</string>
    <!-- Vihjeiden palauttamisen onnistumisviesti. -->
    <string name="settings_tips_reset_done">As dicas voltarão a aparecer.</string>
    <!-- Valmistelulistan tehtävä: ohjeen liittäminen. -->
    <string name="project_setup_pattern">Anexe a receita</string>
    <!-- Valmistelulistan valmis ohjeliitos. -->
    <string name="project_setup_pattern_done">Receita anexada</string>
    <!-- Valmistelulistan tehtävä: käytetyn langan lisääminen. -->
    <string name="project_setup_yarn">Adicione o fio que está a usar</string>
    <!-- Valmistelulistan valmis lankatieto. -->
    <string name="project_setup_yarn_done">Fio adicionado</string>
    <!-- Valmistelulistan valmis työskentelyjakso. -->
    <string name="project_setup_session_done">Sessão de trabalho guardada</string>
    <!-- Valmistelulistan piilotuspainike. -->
    <string name="project_setup_hide">Ocultar</string>
    <!-- Edistymisen saavutettava kuvaus; %1$d tehtyä kohtaa yhteensä %2$d kohdasta. -->
    <string name="stitch_progress_a11y">%1$d de %2$d concluídos</string>
    <!-- Sovelluksen sisäisen oppaan näyttöotsikko. -->
    <string name="guide_screen_title">Como usar o KnitTools</string>
    <!-- Oppaan johdanto; käyttäjä valitsee senhetkiseen tekemiseen sopivan aiheen. -->
    <string name="guide_intro">Escolha o que está a fazer agora. Pode voltar aqui a qualquer momento.</string>
    <!-- Asetusten linkki sovelluksen sisäiseen oppaaseen. -->
    <string name="guide_entry_settings">Como usar o KnitTools</string>
    <!-- Projektisivun linkki työkalujen käyttöohjeisiin. -->
    <string name="guide_entry_overview">Como funcionam as ferramentas do projeto</string>
    <!-- Oppaan toiminto avaa esiteltävän työkalun. -->
    <string name="guide_try_it">Experimentar</string>
    <!-- Projektin jatkamista käsittelevän opasaiheen otsikko. -->
    <string name="guide_topic_continue_title">Continuar um projeto</string>
    <!-- Opasaiheen alaotsikko; Undo käyttää sovelluksen paikallistettua kumoamistermiä. -->
    <string name="guide_topic_continue_subtitle">Contador, Anular e a página do projeto</string>
    <!-- Laskemista käsittelevän opaskohdan otsikko. -->
    <string name="guide_continue_count_title">Conte à medida que avança</string>
    <!-- Plus, suuri numero ja miinus ovat laskurin painikkeita. -->
    <string name="guide_continue_count_body">Toque em + quando terminar uma carreira. Tocar no número grande também acrescenta uma. O menos retira uma.</string>
    <!-- Kumoamista käsittelevän opaskohdan otsikko. -->
    <string name="guide_continue_undo_title">Anule os enganos</string>
    <!-- Kumoaminen palauttaa viime muutoksia yksi painallus kerrallaan. -->
    <string name="guide_continue_undo_body">Anular reverte as alterações recentes, uma por toque.</string>
    <!-- Askelkoon opaskohdan otsikko. -->
    <string name="guide_continue_step_title">Conte mais de uma unidade</string>
    <!-- ×1 on painikkeiden välisen askelvalitsimen näkyvä merkintä; arvo on projektikohtainen. -->
    <string name="guide_continue_step_body">O círculo ×1 entre os botões define quanto cada toque acrescenta, de 1 a 99, separadamente para cada projeto.</string>
    <!-- Projektisivun ja laskurin eroa kuvaava otsikko. -->
    <string name="guide_continue_project_page_title">Página do projeto e contador</string>
    <!-- Projektikortti avaa tiedot ja jatkamistoiminto laskurin. -->
    <string name="guide_continue_project_page_body">Tocar num projeto abre a página com a receita, o fio, as notas e as fotos. Continuar abre o contador.</string>
    <!-- Keskeneräisen projektin löytämistä käsittelevä otsikko. -->
    <string name="guide_continue_find_title">Encontre o projeto novamente</string>
    <!-- Projects käyttää nykyisen Projektit-välilehden paikallistettua nimeä. -->
    <string name="guide_continue_find_body">Um projeto que já começou fica no topo de Projetos, pronto para continuar.</string>
    <!-- Aloitusnäytön laskemista käsittelevä otsikko. -->
    <string name="guide_continue_widget_title">Conte a partir do ecrã inicial</string>
    <!-- Widget tarkoittaa Androidin aloitusnäytön laskuripienoisohjelmaa. -->
    <string name="guide_continue_widget_body">Adicione o widget do contador para contar sem abrir a aplicação.</string>
    <!-- Ohjeen lukemista käsittelevän opasaiheen otsikko. -->
    <string name="guide_topic_pattern_title">Siga a receita</string>
    <!-- Verkko-ohjeen nimitys vastaa nykyistä käyttöliittymää. -->
    <string name="guide_topic_pattern_subtitle">PDF, modelos online e linha de leitura</string>
    <!-- Ohjeen liittämisen opaskohdan otsikko. -->
    <string name="guide_pattern_attach_title">Anexe a receita</string>
    <!-- PDF voidaan tuoda puhelimesta tai pilvitallennuksesta; verkko-ohje on linkki. -->
    <string name="guide_pattern_attach_body">Adicione um PDF do telemóvel ou do armazenamento na nuvem, ou guarde uma ligação para um modelo online.</string>
    <!-- Useiden projektidokumenttien opaskohdan otsikko. -->
    <string name="guide_pattern_documents_title">Vários documentos</string>
    <!-- Jokainen projektin PDF muistaa oman sivunsa. -->
    <string name="guide_pattern_documents_body">Um projeto pode ter vários PDF. Cada um guarda a sua própria página.</string>
    <!-- Lukemisen ja merkintätilan opaskohdan otsikko. -->
    <string name="guide_pattern_markup_title">Leia e anote</string>
    <!-- Mark up viittaa nykyiseen paikallistettuun merkintätilaan. -->
    <string name="guide_pattern_markup_body">O modo de leitura dá todo o ecrã à página. Anotar acrescenta canetas, marcadores, texto e ferramentas para gráficos.</string>
    <!-- PDF-lukulinjan opaskohdan otsikko. -->
    <string name="guide_pattern_reading_line_title">A linha de leitura</string>
    <!-- Follow main counter viittaa nykyiseen asetukseen; kalibrointi kohdistaa laskurin kerrokset. -->
    <string name="guide_pattern_reading_line_body">Ative Seguir o contador principal e a linha acompanha a contagem. Calibre as posições do contador uma vez se as carreiras não coincidirem.</string>
    <!-- PDF-kirjanmerkkien opaskohdan otsikko. -->
    <string name="guide_pattern_bookmarks_title">Marcadores</string>
    <!-- Kirjanmerkit tallentavat usein käytetyt kohdat. -->
    <string name="guide_pattern_bookmarks_body">Marque os pontos a que volta com frequência.</string>
    <!-- Ravelryn ohjeita käsittelevän opaskohdan otsikko. -->
    <string name="guide_pattern_ravelry_title">Receitas do Ravelry</string>
    <!-- Kirjautuminen tapahtuu Ravelryn omalla sivulla; lataus koskee käyttäjän omia PDF-tiedostoja. -->
    <string name="guide_pattern_ravelry_body">Abra o Ravelry na aplicação, inicie sessão na própria página do Ravelry e descarregue os PDF que lhe pertencem diretamente para o KnitTools.</string>
    <!-- Paperiohjeen kuvaamisen opaskohdan otsikko. -->
    <string name="guide_pattern_camera_title">Receitas em papel</string>
    <!-- Valokuvista luodaan PDF; ei skanneri- tai tekstintunnistuslupausta. -->
    <string name="guide_pattern_camera_body">Fotografe as páginas e o KnitTools transforma-as num PDF.</string>
    <!-- Lankojen järjestämistä käsittelevän opasaiheen otsikko. -->
    <string name="guide_topic_yarn_title">Mantenha os fios organizados</string>
    <!-- My Yarn käyttää täsmälleen nykyistä my_yarn_title-käännöstä. -->
    <string name="guide_topic_yarn_subtitle">Fio do projeto, quantidades e O meu fio</string>
    <!-- Projektin lankatietojen opaskohdan otsikko. -->
    <string name="guide_yarn_project_title">Fio para este projeto</string>
    <!-- Suunniteltu, projektille varattu ja käytetty määrä ovat erillisiä lankamääriä. -->
    <string name="guide_yarn_project_body">Registe o fio que usa no projeto, com as quantidades planeadas, reservadas e utilizadas.</string>
    <!-- Jäljellä olevan lankamäärän selityksen otsikko käyttää nykyistä paikallistettua nimikettä. -->
    <string name="guide_yarn_remaining_title">O que significa Restante</string>
    <!-- Jäljellä oleva määrä koskee projektin varausta; yleinen lankavarasto ei muutu automaattisesti. -->
    <string name="guide_yarn_remaining_body">Restante é o que sobra do fio reservado para este projeto. As quantidades do seu stock não mudam sozinhas.</string>
    <!-- My Yarn käyttää täsmälleen nykyistä my_yarn_title-käännöstä. -->
    <string name="guide_yarn_my_yarn_title">O meu fio</string>
    <!-- Lankakirjaston korttiin tallennetaan värinumero, värjäyserä ja valokuvat. -->
    <string name="guide_yarn_my_yarn_body">Guarde o fio uma vez, com número da cor, lote de tingimento e fotos, e depois associe-o a qualquer projeto.</string>
    <!-- Projektin lisätietojen opasaiheen otsikko. -->
    <string name="guide_topic_details_title">Lembre-se dos detalhes</string>
    <!-- Lisätietojen opasaiheen sisältöluettelo ilman koriste-erottimia. -->
    <string name="guide_topic_details_subtitle">Notas, contadores extra, lembretes e fotos</string>
    <!-- Muistiinpanojen opaskohdan otsikko. -->
    <string name="guide_details_notes_title">Notas</string>
    <!-- Muistiinpanoihin voi kirjata välineiden koot, muutokset ja jatkosuunnitelmat. -->
    <string name="guide_details_notes_body">Guarde os tamanhos das agulhas, as alterações e os próximos passos.</string>
    <!-- Lisälaskurien opaskohdan otsikko. -->
    <string name="guide_details_counters_title">Contadores extra</string>
    <!-- Lisälaskurit seuraavat toistoja, muotoilua tai kerrosjaksoa päälaskurin rinnalla. -->
    <string name="guide_details_counters_body">Conte repetições, moldagem ou um conjunto de carreiras ao lado da contagem principal.</string>
    <!-- Kerrosmuistutusten opaskohdan otsikko. -->
    <string name="guide_details_reminders_title">Lembretes de carreira</string>
    <!-- Muistutus näkyy sovelluksessa, ei puhelimen ilmoituksena. -->
    <string name="guide_details_reminders_body">Receba um lembrete na aplicação ao chegar a uma carreira, como a da próxima diminuição. Os lembretes aparecem dentro do KnitTools, não como notificações do telemóvel.</string>
    <!-- Edistymiskuvien opaskohdan otsikko. -->
    <string name="guide_details_photos_title">Fotos do progresso</string>
    <!-- Uusin edistymiskuva toimii projektin kuvana. -->
    <string name="guide_details_photos_body">Tire fotos à medida que o projeto cresce. A mais recente passa a ser a imagem do projeto.</string>
    <!-- Laskennan, seurannan ja varmuuskopioinnin opasaiheen otsikko. -->
    <string name="guide_topic_tools_title">Calcule, acompanhe e faça cópias de segurança</string>
    <!-- Insights käyttää nykyisen tilastovälilehden paikallistettua nimeä. -->
    <string name="guide_topic_tools_subtitle">Ferramentas, tempo de trabalho, Estatísticas e cópia de segurança</string>
    <!-- Laskentatyökalujen opaskohdan otsikko. -->
    <string name="guide_tools_calculators_title">Calculadoras</string>
    <!-- Työkalut käsittelevät neuletiheyttä, lisäyksiä, kavennuksia, luontia ja lankamääriä. -->
    <string name="guide_tools_calculators_body">Tensão, aumentos e diminuições, montagem de malhas e quantidades de fio. Funcionam offline.</string>
    <!-- Hakuteosten opaskohdan otsikko. -->
    <string name="guide_tools_reference_title">Referência</string>
    <!-- Library käyttää nykyisen Kirjasto-välilehden paikallistettua nimeä. -->
    <string name="guide_tools_reference_body">Na Biblioteca encontra tamanhos de agulhas, tabelas de medidas, abreviaturas e símbolos de gráficos.</string>
    <!-- Työajan opaskohdan otsikko. -->
    <string name="guide_tools_work_time_title">Tempo de trabalho</string>
    <!-- Työskentelyjakso käynnistetään ja lopetetaan käsin; lopuksi sen voi tallentaa tai hylätä. -->
    <string name="guide_tools_work_time_body">Inicie uma sessão de trabalho no menu do projeto para registar o tempo. Quando terminar, pare a sessão para a guardar ou descartar.</string>
    <!-- Insights käyttää nykyisen tilastovälilehden paikallistettua nimeä. -->
    <string name="guide_tools_insights_title">Estatísticas</string>
    <!-- Työaika on perustieto; Pro lisää kaaviot ja peräkkäisten aktiivisten päivien seurannan. -->
    <string name="guide_tools_insights_body">Veja o tempo que registou. O Pro acrescenta gráficos diários, semanais e mensais e a sua sequência de dias ativos.</string>
    <!-- Projektikansioiden opaskohdan otsikko. -->
    <string name="guide_tools_folders_title">Pastas</string>
    <!-- Kansiot avataan Projektit-otsikosta; vain keskeneräiset projektit kuluttavat maksutonta paikkaa. -->
    <string name="guide_tools_folders_body">Agrupe projetos em pastas a partir do título Projetos. Um projeto em curso de cada vez é gratuito, e os projetos concluídos não contam.</string>
    <!-- Varmuuskopioinnin opaskohdan otsikko. -->
    <string name="guide_tools_backup_title">Cópia de segurança</string>
    <!-- Varmuuskopio on tiedosto; palautus korvaa puhelimen nykyiset sovellustiedot. -->
    <string name="guide_tools_backup_body">Crie um ficheiro de cópia de segurança e guarde-o num local seguro, como o seu armazenamento na nuvem. O restauro substitui tudo neste telemóvel.</string>
    <!-- Lyhyt kudotun merkin teksti, joka kertoo toiminnon olevan käytössä kokeilun ajan. -->
    <string name="pro_marker_trial">AVALIAÇÃO</string>
    <!-- Projektin toimintovalikon löytörivit. Widget tarkoittaa Androidin aloitusnäytön pienoisohjelmaa. -->
    <string name="pro_repeat_counter_row">Contador de repetições</string>
    <!-- Projektivalikon toiminto pyytää Androidia lisäämään laskuripienoisohjelman aloitusnäyttöön. -->
