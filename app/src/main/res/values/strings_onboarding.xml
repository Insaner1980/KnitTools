    <!-- Aloituslukeman validointivirhe. %1$s on muotoiltu sallittu yläraja. -->
    <string name="project_start_count_error">Enter a number from 0 to %1$s.</string>
    <!-- Projektin valinnaisen tavoitelukeman kentän nimi. -->
