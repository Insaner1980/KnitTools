    <!-- Seuraava kerros; %1$d on numero. -->
    <string name="project_start_count_next_rows">A seguir: carreira %1$d</string>
    <!-- Seuraava kierros; %1$d on numero. -->
    <string name="project_start_count_next_rounds">A seguir: volta %1$d</string>
    <!-- Seuraava toisto; %1$d on numero. -->
    <string name="project_start_count_next_repeats">A seguir: repetição %1$d</string>
    <!-- Mukautetun yksikön seuraava arvo; %1$d on numero. -->
    <string name="project_start_count_next_custom">A seguir: %1$d</string>
    <!-- Aloitusarvon virhe; %1$s on valmiiksi paikallistettu enimmäisluku. -->
