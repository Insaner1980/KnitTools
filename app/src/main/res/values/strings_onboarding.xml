    <!-- Virkkausprojektin nimen esimerkki; säilytä luonnollinen kirjainkoko. -->
    <string name="project_name_placeholder_crochet">Granny square blanket</string>
    <!-- Luontilomakkeen jo tehtyjen kerrosten kentän nimi. -->
