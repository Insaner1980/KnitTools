    <!-- Tavoite näyttää jäljellä olevan määrän laskemisen aikana. -->
    <string name="project_target_help">See how many are left as you go.</string>
    <!-- Tavoitteen validointivirhe. %1$s on muotoiltu sallittu yläraja. -->
    <string name="project_target_error">Enter a number from 1 to %1$s.</string>
    <!-- Projektin luontiesikatselun saavutettavuuskuvaus. %1$s on laskurin koko näyttöteksti. -->
    <string name="project_create_preview_a11y">Preview: %1$s</string>
    <!-- Vihjeen kuittaava neutraali tekstipainike. -->
    <string name="tip_got_it">Got it</string>
    <!-- Kerroslaskurin ensimmäinen vihje; + ja suuri numero ovat lisäystoimintoja. -->
    <string name="tip_first_row_rows">When you finish a row, tap +. Tapping the big number works too.</string>
    <!-- Kierroslaskurin ensimmäinen vihje; + ja suuri numero ovat lisäystoimintoja. -->
    <string name="tip_first_row_rounds">When you finish a round, tap +. Tapping the big number works too.</string>
    <!-- Toistolaskurin ensimmäinen vihje; + ja suuri numero ovat lisäystoimintoja. -->
    <string name="tip_first_row_repeats">When you finish a repeat, tap +. Tapping the big number works too.</string>
    <!-- Mukautetun laskurin ensimmäinen vihje; älä oleta kerroksia tai kierroksia. -->
    <string name="tip_first_row_custom">Tap + each time you finish one. Tapping the big number works too.</string>
    <!-- Tallennetun laskurimuutoksen vihje. Undo on sovelluksen Kumoa-toiminto. -->
    <string name="tip_undo">Saved. Tapped by mistake? Undo takes back the last change.</string>
    <!-- Askelkoon vihje: yhden napautuksen lisäysmäärä on muokattavissa. -->
    <string name="tip_step_size">Counting more than one at a time? Change how much each tap adds here.</string>
    <!-- Työskentelyistunto käynnistyy käyttäjän toimesta valikosta, ei automaattisesti. -->
    <string name="tip_work_session">Want to know how long this project takes? Start a work session from this menu. Time never starts on its own.</string>
    <!-- Projektisivun vihje; Continue tarkoittaa nykyistä Jatka-toimintoa. -->
    <string name="tip_overview_intro">This is your whole project: pattern, yarn, notes and photos. Continue takes you back to the counter.</string>
    <!-- Ohjeruudun vihje; pattern tarkoittaa käsityöohjetta, suomeksi ohje. -->
    <string name="tip_pattern_tile">Attach your pattern to keep it with this project.</string>
    <!-- PDF-vihje; Follow main counter käännetään samalla nimellä kuin lukijan asetus. -->
    <string name="tip_reading_line">Turn on Follow main counter and the reading line moves as you count.</string>
    <!-- Vihje laskurin näytön päällä pitämisestä. -->
    <string name="tip_keep_screen_on">Screen going dark while you work? Keep it on while you count.</string>
    <!-- Vihjeen painike ottaa näytön päällä pitämisen käyttöön. -->
    <string name="tip_keep_screen_on_action">Keep screen on</string>
    <!-- Tavoitteen saavuttaminen ei päätä projektia automaattisesti. -->
    <string name="tip_target_reached">Target reached. Keep counting, or mark the project finished from the project page menu.</string>
    <!-- Ensimmäisen tallennetun työskentelyistunnon vihje näyttää projektin kokonaisajan paikan. -->
    <string name="tip_first_session_saved">Your first work session is saved. The total time for this project is here.</string>
    <!-- Paikallisen tiedon varmuuskopiointivihje; älä lupaa automaattista pilvisynkronointia. -->
    <string name="tip_backup">Your projects are only on this phone. Make a backup so they\'re safe if you switch phones.</string>
    <!-- Vihjeen toiminto avaa varmuuskopioinnin. -->
    <string name="tip_backup_action">Back up</string>
    <!-- Kansiovihje; otsikon painaminen avaa projektien kansiovalinnan. -->
    <string name="tip_folders">Lots of projects? Sort them into folders from the title.</string>
    <!-- Widget on Androidin aloitusnäytön laskuripienoisohjelma. -->
    <string name="tip_widget">Count from your home screen without opening the app.</string>
    <!-- Vihjeen toiminto avaa saman widgetin lisäyksen kuin laskurin valikko. -->
    <string name="tip_widget_action">Add widget</string>
    <!-- Työkalujen aloitusvihje; laskurit toimivat ilman verkkoyhteyttä. -->
    <string name="tip_tools_intro">The calculators work offline. Example values show what to enter.</string>
    <!-- Asetusten toiminto nollaa nähtyjen vihjeiden tilan. -->
    <string name="settings_show_tips_again">Show tips again</string>
    <!-- Vihjeiden onnistuneen nollauksen palaute. -->
    <string name="settings_tips_reset_done">Tips will show again.</string>
    <!-- Aloitusprojektin valmistelulistan otsikko. -->
    <string name="project_setup_title">Project setup</string>
    <!-- Valmistelun edistyminen. %1$d on valmiiden vaiheiden määrä ja %2$d kaikkien vaiheiden määrä. -->
    <string name="project_setup_progress">%1$d of %2$d</string>
    <!-- Valmistelulistan aloituskohta; toiminto avaa laskurin aloitusarvon. -->
    <string name="project_setup_starting_point">Set your starting point</string>
    <!-- Valmistelulistan aloituskohta on asetettu. -->
    <string name="project_setup_starting_point_done">Starting point set</string>
    <!-- Valmistelulistan ohjeen liittämistoiminto; pattern on ohje. -->
    <string name="project_setup_pattern">Attach your pattern</string>
    <!-- Valmistelulistan ohje on liitetty. -->
    <string name="project_setup_pattern_done">Pattern attached</string>
    <!-- Valmistelulistan projektikohtaisen langan lisäämistoiminto. -->
    <string name="project_setup_yarn">Add the yarn you\'re using</string>
    <!-- Valmistelulistan projektikohtainen lanka on lisätty. -->
    <string name="project_setup_yarn_done">Yarn added</string>
    <!-- Valmistelulistan ensimmäisen työskentelyistunnon tallennus. -->
    <string name="project_setup_session">Save your first work session</string>
    <!-- Valmistelulistan ensimmäinen työskentelyistunto on tallennettu. -->
    <string name="project_setup_session_done">Work session saved</string>
    <!-- Valmistelulistan lyhyt valmistumisviesti. -->
    <string name="project_setup_done">All set. Enjoy your project.</string>
    <!-- Valmistelulistan piilottava neutraali toiminto. -->
    <string name="project_setup_hide">Hide</string>
    <!-- Edistymisen saavutettavuuskuvaus. %1$d on valmiiden ja %2$d kaikkien vaiheiden määrä. Neutraali suhdeluku ei vaadi monikkotaivutusta. -->
    <string name="stitch_progress_a11y" tools:ignore="PluralsCandidate">%1$d of %2$d done</string>
    <!-- Sovelluksen sisäisen käyttöoppaan näyttöotsikko; englanniksi Title Case. -->
    <string name="guide_screen_title">How to Use KnitTools</string>
    <!-- Oppaan aloitusteksti; käyttäjä voi valita nykyiseen tekemiseensä sopivan aiheen. -->
    <string name="guide_intro">Pick what you\'re doing right now. You can come back here any time.</string>
    <!-- Asetusten linkki käyttöoppaaseen; sama nimi kuin oppaan näyttöotsikossa. -->
    <string name="guide_entry_settings">How to Use KnitTools</string>
    <!-- Projektisivun alareunan linkki projektityökalujen käyttöoppaaseen. -->
    <string name="guide_entry_overview">How project tools work</string>
    <!-- Oppaan toiminto avaa olemassa olevan työkalun tai näkymän. -->
    <string name="guide_try_it">Try it</string>
    <!-- Oppaan aiheen näyttöotsikko: projektin jatkaminen. Vain englanniksi Title Case. -->
    <string name="guide_topic_continue_title">Continue a Project</string>
    <!-- Oppaan aiheen lyhyt kuvaus: projektin jatkaminen. -->
    <string name="guide_topic_continue_subtitle">Counter, Undo and your project page</string>
    <!-- Oppaan kohdan otsikko: kerrosten laskeminen plus- ja miinuspainikkeilla. -->
    <string name="guide_continue_count_title">Count as You Go</string>
    <!-- Oppaan kohdan selitys: kerrosten laskeminen plus- ja miinuspainikkeilla. -->
    <string name="guide_continue_count_body">Tap + when you finish a row. Tapping the big number adds one too. Minus takes one away.</string>
    <!-- Oppaan kohdan otsikko: viimeisimpien laskurimuutosten kumoaminen. -->
    <string name="guide_continue_undo_title">Undo Mistakes</string>
    <!-- Oppaan kohdan selitys: viimeisimpien laskurimuutosten kumoaminen. -->
    <string name="guide_continue_undo_body">Undo steps back through your recent changes, one tap at a time.</string>
    <!-- Oppaan kohdan otsikko: projektikohtainen laskurin askelkoko 1–99 ja ×1-painike. -->
    <string name="guide_continue_step_title">Count More Than One</string>
    <!-- Oppaan kohdan selitys: projektikohtainen laskurin askelkoko 1–99 ja ×1-painike. -->
    <string name="guide_continue_step_body">The ×1 ring between the buttons sets how much each tap adds, from 1 to 99, separately for each project.</string>
    <!-- Oppaan kohdan otsikko: projektisivun ja laskurin ero; Continue on nykyinen Jatka-toiminto. -->
    <string name="guide_continue_project_page_title">Project Page and Counter</string>
    <!-- Oppaan kohdan selitys: projektisivun ja laskurin ero; Continue on nykyinen Jatka-toiminto. -->
    <string name="guide_continue_project_page_body">Tapping a project opens its project page with the pattern, yarn, notes and photos. Continue opens the counter.</string>
    <!-- Oppaan kohdan otsikko: jatkettavan projektin löytäminen Projektit-näkymän yläosasta. -->
    <string name="guide_continue_find_title">Find It Again</string>
    <!-- Oppaan kohdan selitys: jatkettavan projektin löytäminen Projektit-näkymän yläosasta. -->
    <string name="guide_continue_find_body">A project you\'ve started waits at the top of Projects, ready to continue.</string>
    <!-- Oppaan kohdan otsikko: laskeminen Androidin aloitusnäytön pienoisohjelmalla. -->
    <string name="guide_continue_widget_title">Count from Your Home Screen</string>
    <!-- Oppaan kohdan selitys: laskeminen Androidin aloitusnäytön pienoisohjelmalla. -->
    <string name="guide_continue_widget_body">Add the counter widget to count without opening the app.</string>
    <!-- Oppaan aiheen näyttöotsikko: ohjeen seuraaminen. Vain englanniksi Title Case. -->
    <string name="guide_topic_pattern_title">Follow Your Pattern</string>
    <!-- Oppaan aiheen lyhyt kuvaus: ohjeen seuraaminen. -->
    <string name="guide_topic_pattern_subtitle">PDFs, web patterns and the reading line</string>
    <!-- Oppaan kohdan otsikko: PDF:n liittäminen tai verkko-ohjeen linkin tallentaminen; pattern on ohje. -->
    <string name="guide_pattern_attach_title">Attach Your Pattern</string>
    <!-- Oppaan kohdan selitys: PDF:n liittäminen tai verkko-ohjeen linkin tallentaminen; pattern on ohje. -->
    <string name="guide_pattern_attach_body">Add a PDF from your phone or cloud storage, or save a link to a web pattern.</string>
    <!-- Oppaan kohdan otsikko: projektin useat PDF-tiedostot ja kunkin oma sivu. -->
    <string name="guide_pattern_documents_title">Several Documents</string>
    <!-- Oppaan kohdan selitys: projektin useat PDF-tiedostot ja kunkin oma sivu. -->
    <string name="guide_pattern_documents_body">A project can hold several PDFs. Each one remembers its own page.</string>
    <!-- Oppaan kohdan otsikko: lukutilan ja merkintätilan ero; markup tarkoittaa PDF-merkintöjä. -->
    <string name="guide_pattern_markup_title">Read and Mark Up</string>
    <!-- Oppaan kohdan selitys: lukutilan ja merkintätilan ero; markup tarkoittaa PDF-merkintöjä. -->
    <string name="guide_pattern_markup_body">Reading mode gives the page the whole screen. Mark up adds pens, highlighters, text and chart tools.</string>
    <!-- Oppaan kohdan otsikko: lukulinja ja kalibrointi; Follow main counter on nykyisen asetuksen nimi. -->
    <string name="guide_pattern_reading_line_title">The Reading Line</string>
    <!-- Oppaan kohdan selitys: lukulinja ja kalibrointi; Follow main counter on nykyisen asetuksen nimi. -->
    <string name="guide_pattern_reading_line_body">Turn on Follow main counter and the line moves as you count. Calibrate counter positions once if your rows don\'t line up.</string>
    <!-- Oppaan kohdan otsikko: ohjeen usein tarvittavien kohtien kirjanmerkit. -->
    <string name="guide_pattern_bookmarks_title">Bookmarks</string>
    <!-- Oppaan kohdan selitys: ohjeen usein tarvittavien kohtien kirjanmerkit. -->
    <string name="guide_pattern_bookmarks_body">Bookmark the spots you keep coming back to.</string>
    <!-- Oppaan kohdan otsikko: omat Ravelry-PDF:t ja kirjautuminen Ravelryn omalla sivulla. -->
    <string name="guide_pattern_ravelry_title">Patterns from Ravelry</string>
    <!-- Oppaan kohdan selitys: omat Ravelry-PDF:t ja kirjautuminen Ravelryn omalla sivulla. -->
    <string name="guide_pattern_ravelry_body">Open Ravelry in the app, sign in on Ravelry\'s own page, and download PDFs you own straight into KnitTools.</string>
    <!-- Oppaan kohdan otsikko: paperiohjeen valokuvaaminen PDF:ksi; älä käytä skannausilmausta. -->
    <string name="guide_pattern_camera_title">Paper Patterns</string>
    <!-- Oppaan kohdan selitys: paperiohjeen valokuvaaminen PDF:ksi; älä käytä skannausilmausta. -->
    <string name="guide_pattern_camera_body">Photograph the pages and KnitTools turns them into a PDF.</string>
    <!-- Oppaan aiheen näyttöotsikko: lankatietojen järjestäminen. Vain englanniksi Title Case. -->
    <string name="guide_topic_yarn_title">Keep Yarn Organized</string>
    <!-- Oppaan aiheen lyhyt kuvaus: lankatietojen järjestäminen. -->
    <string name="guide_topic_yarn_subtitle">Project yarn, amounts and My Yarn</string>
    <!-- Oppaan kohdan otsikko: projektikohtainen lanka sekä suunniteltu, varattu ja käytetty määrä. -->
    <string name="guide_yarn_project_title">Yarn for This Project</string>
    <!-- Oppaan kohdan selitys: projektikohtainen lanka sekä suunniteltu, varattu ja käytetty määrä. -->
    <string name="guide_yarn_project_body">Note the yarn you\'re using in the project, with planned, allocated and used amounts.</string>
    <!-- Oppaan kohdan otsikko: projektille varatun langan jäljellä oleva määrä, ei automaattisesti muuttuva lankavarasto. -->
    <string name="guide_yarn_remaining_title">What Remaining Means</string>
    <!-- Oppaan kohdan selitys: projektille varatun langan jäljellä oleva määrä, ei automaattisesti muuttuva lankavarasto. -->
    <string name="guide_yarn_remaining_body">Remaining is what\'s left of the yarn allocated to this project. Your stash numbers don\'t change on their own.</string>
    <!-- Oppaan kohdan otsikko: lankakirjasto; My Yarn käännetään samalla nimellä kuin my_yarn_title. -->
    <string name="guide_yarn_my_yarn_title">My Yarn</string>
    <!-- Oppaan kohdan selitys: lankakirjasto; My Yarn käännetään samalla nimellä kuin my_yarn_title. -->
    <string name="guide_yarn_my_yarn_body">Save yarn once with color number, dye lot and photos, then link it to any project.</string>
    <!-- Oppaan aiheen näyttöotsikko: projektin yksityiskohdat. Vain englanniksi Title Case. -->
    <string name="guide_topic_details_title">Remember the Details</string>
    <!-- Oppaan aiheen lyhyt kuvaus: projektin yksityiskohdat. -->
    <string name="guide_topic_details_subtitle">Notes, extra counters, reminders and photos</string>
    <!-- Oppaan kohdan otsikko: projektin puikkokoot, muutokset ja seuraavat työvaiheet. -->
    <string name="guide_details_notes_title">Notes</string>
    <!-- Oppaan kohdan selitys: projektin puikkokoot, muutokset ja seuraavat työvaiheet. -->
    <string name="guide_details_notes_body">Keep needle sizes, changes and what comes next.</string>
    <!-- Oppaan kohdan otsikko: toistojen, muotoilujen ja kerrosjakson laskeminen päälaskurin rinnalla. -->
    <string name="guide_details_counters_title">Extra Counters</string>
    <!-- Oppaan kohdan selitys: toistojen, muotoilujen ja kerrosjakson laskeminen päälaskurin rinnalla. -->
    <string name="guide_details_counters_body">Count repeats, shaping or a section of rows next to the main count.</string>
    <!-- Oppaan kohdan otsikko: sovelluksen sisäiset kerrosmuistutukset, eivät puhelimen ilmoitukset. -->
    <string name="guide_details_reminders_title">Row Reminders</string>
    <!-- Oppaan kohdan selitys: sovelluksen sisäiset kerrosmuistutukset, eivät puhelimen ilmoitukset. -->
    <string name="guide_details_reminders_body">Get a reminder in the app when you reach a row, like the next decrease. Reminders show inside KnitTools, not as phone notifications.</string>
    <!-- Oppaan kohdan otsikko: edistymiskuvat ja uusimman kuvan käyttö projektikuvana. -->
    <string name="guide_details_photos_title">Progress Photos</string>
    <!-- Oppaan kohdan selitys: edistymiskuvat ja uusimman kuvan käyttö projektikuvana. -->
    <string name="guide_details_photos_body">Take photos as your project grows. The newest one becomes the project\'s picture.</string>
    <!-- Oppaan aiheen näyttöotsikko: työkalut, työaika ja varmuuskopiointi. Vain englanniksi Title Case. -->
    <string name="guide_topic_tools_title">Calculate, Track and Back Up</string>
    <!-- Oppaan aiheen lyhyt kuvaus: työkalut, työaika ja varmuuskopiointi. -->
    <string name="guide_topic_tools_subtitle">Tools, work time, Insights and backup</string>
    <!-- Oppaan kohdan otsikko: ilman verkkoyhteyttä toimivat neuletiheyden, muotoilun ja lankamäärän laskurit. -->
    <string name="guide_tools_calculators_title">Calculators</string>
    <!-- Oppaan kohdan selitys: ilman verkkoyhteyttä toimivat neuletiheyden, muotoilun ja lankamäärän laskurit. -->
    <string name="guide_tools_calculators_body">Gauge, increases and decreases, cast-on and yarn amounts. They work offline.</string>
    <!-- Oppaan kohdan otsikko: kirjaston puikkokoot, kokotaulukot, lyhenteet ja ruutupiirrosten merkit. -->
    <string name="guide_tools_reference_title">Reference</string>
    <!-- Oppaan kohdan selitys: kirjaston puikkokoot, kokotaulukot, lyhenteet ja ruutupiirrosten merkit. -->
    <string name="guide_tools_reference_body">Needle sizes, size charts, abbreviations and chart symbols live in Library.</string>
    <!-- Oppaan kohdan otsikko: käyttäjän erikseen aloittama ja lopettama työskentelyistunto. -->
    <string name="guide_tools_work_time_title">Work Time</string>
    <!-- Oppaan kohdan selitys: käyttäjän erikseen aloittama ja lopettama työskentelyistunto. -->
    <string name="guide_tools_work_time_body">Start a work session from the project menu to track your time. Stop when you\'re done to save or discard it.</string>
    <!-- Oppaan kohdan otsikko: tallennettu työaika sekä Pron kaaviot ja aktiivisuusputki. -->
    <string name="guide_tools_insights_title">Insights</string>
    <!-- Oppaan kohdan selitys: tallennettu työaika sekä Pron kaaviot ja aktiivisuusputki. -->
    <string name="guide_tools_insights_body">See the time you\'ve recorded. Pro adds daily, weekly and monthly charts and your streak.</string>
