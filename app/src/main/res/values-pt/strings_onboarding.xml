<resources>
    <!-- Esimerkkikortin tunniste; ei käyttäjän oma projekti. -->
    <string name="welcome_example_label">Exemplo</string>
    <!-- Esimerkkilaskurin ensimmäinen toimintaohje. -->
    <string name="welcome_demo_try">Experimente: toque em + quando terminar uma carreira.</string>
    <!-- Ensimmäisen esimerkkipainalluksen palaute; %1$d on kerrosnumero ja Undo on kumoamistoiminto. -->
    <string name="welcome_demo_after_first">A carreira %1$d está guardada. Tocou por engano? Anular volta atrás.</string>
    <!-- Esimerkin toinen palaute kertoo paikan muistamisesta. -->
    <string name="welcome_demo_after_second">É isso. O KnitTools lembra-se de onde ficou, para que não tenha de o fazer.</string>
    <!-- Esimerkkilaskurin kumoamispainike. -->
    <string name="welcome_demo_undo">Anular</string>
    <!-- Esimerkkilaskurin saavutettava kuvaus; %1$d on kerrosnumero. -->
    <string name="welcome_demo_a11y">Contador de exemplo na carreira %1$d. A linha de leitura da receita de exemplo acompanha o contador.</string>
    <!-- Esimerkin pluspainikkeen saavutettava nimi. -->
    <string name="welcome_plus_a11y">Adicionar uma carreira ao exemplo</string>
    <!-- Aloitusnäkymän otsikko, joka kannustaa jatkamaan kesken jäänyttä työtä. -->
    <string name="welcome_screen_title">Retome de onde ficou</string>
    <!-- Aloituksen hyötyteksti laskurista, ohjeesta ja projektitiedoista. -->
    <string name="welcome_body">O KnitTools reúne a contagem, a posição na receita e os detalhes do projeto. Pode pousar o trabalho a qualquer momento e retomar exatamente onde ficou.</string>
    <!-- Tilittömyys ja tietojen paikallinen säilytys puhelimessa. -->
    <string name="welcome_trust">Não precisa de conta. Os seus projetos ficam neste telemóvel.</string>
    <!-- Toiminto avaa laskentatyökalut ilman projektin luomista. -->
    <string name="welcome_tools_only">Só preciso das ferramentas</string>
    <!-- Esittelyn sulkupainikkeen saavutettava nimi. -->
    <string name="welcome_dismiss_a11y">Ocultar introdução</string>
    <!-- Neulontaan sopiva kysymys keskeneräisestä työstä; puikot ovat luonteva paikallinen ilmaus. -->
    <string name="start_compact_title_knitting">O que tem nas agulhas?</string>
    <!-- Virkkaukseen sopiva kysymys keskeneräisestä työstä; koukku tarkoittaa virkkuukoukkua. -->
    <string name="start_compact_title_crochet">O que tem na agulha de croché?</string>
    <!-- Tiiviin aloitustilan ohje projektin lisäämiseen. -->
    <string name="start_compact_body">Adicione o projeto em que está a trabalhar ou comece um novo.</string>
    <!-- Neuleprojektin nimikentän esimerkki. -->
    <string name="project_name_placeholder_knitting">Meias às riscas</string>
    <!-- Virkkausprojektin nimikentän esimerkki: isoäidinneliöistä tehty peitto. -->
    <string name="project_name_placeholder_crochet">Manta de quadrados de croché</string>
    <!-- Jo tehtyjen kerrosten määrä ennen projektin luomista. -->
    <string name="project_start_count_label_rows">Carreiras já feitas</string>
    <!-- Jo tehtyjen kierrosten määrä ennen projektin luomista. -->
    <string name="project_start_count_label_rounds">Voltas já feitas</string>
    <!-- Jo tehtyjen toistojen määrä ennen projektin luomista. -->
    <string name="project_start_count_label_repeats">Repetições já feitas</string>
    <!-- Mukautetun laskuriyksikön aloitusarvo. -->
    <string name="project_start_count_label_custom">Contagem até agora</string>
    <!-- Uuden työn aloitusarvo on nolla. -->
